const int SENSOR_PIN = A1;

double alpha = 0.75;
double oldValue = 0.0;

void setup() {
   Serial.begin(9600);
   pinMode(SENSOR_PIN, INPUT);
}

void loop() {
   // Leer valor crudo del sensor de pulso
   int rawValue = analogRead(SENSOR_PIN);

   // Aplicar filtro paso bajo para suavizar la señal
   double value = alpha * oldValue + (1 - alpha) * rawValue;

   // Mostrar valores crudos y filtrados
   Serial.print(rawValue);
   Serial.print(",");
   Serial.println(value);

   oldValue = value;
   delay(100);
}
